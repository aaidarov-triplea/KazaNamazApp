@model List<KN.WEB.ViewModels.UserRowViewModel>
@{ ViewData["Title"] = "Пользователи"; }

<h2>Пользователи</h2>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<table class="table table-striped table-sm align-middle">
    <thead>
    <tr>
        <th>Email</th>
        <th>Имя</th>
        <th>Регистрация</th>
        <th>Роли</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>@u.FullName</td>
            <td>@u.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td>@string.Join(", ", u.Roles)</td>
            <td>
                @if (!u.IsCurrent)
                {
                    <form asp-action="ToggleAdmin" asp-route-id="@u.Id" method="post">
                        <button type="submit" class="btn btn-sm @(u.IsAdmin ? "btn-outline-danger" : "btn-outline-primary")">
                            @(u.IsAdmin ? "Снять админа" : "Сделать админом")
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>